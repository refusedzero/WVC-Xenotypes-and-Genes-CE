<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Preserve FleshmassArmor heat offset while converting physical armor. -->

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/GeneDef[defName="WVC_FleshmassArmor"]/statOffsets/ArmorRating_Sharp</xpath>
    <value><ArmorRating_Sharp>10</ArmorRating_Sharp></value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/GeneDef[defName="WVC_FleshmassArmor"]/statOffsets/ArmorRating_Blunt</xpath>
    <value><ArmorRating_Blunt>30</ArmorRating_Blunt></value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/GeneDef[defName="WVC_BioferriteGrowths"]/statOffsets/ArmorRating_Sharp</xpath>
    <value><ArmorRating_Sharp>1</ArmorRating_Sharp></value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/GeneDef[defName="WVC_BioferriteGrowths"]/statOffsets/ArmorRating_Blunt</xpath>
    <value><ArmorRating_Blunt>1</ArmorRating_Blunt></value>
  </Operation>

</Patch>
